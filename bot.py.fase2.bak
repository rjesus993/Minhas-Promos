# bot.py
import asyncio
import html
import logging
import time

from telethon import TelegramClient, events
from telethon.errors import FloodWaitError
from telethon.sessions import StringSession
from telethon.tl.types import User, Chat, Channel

from config import API_ID, API_HASH, SESSION, PHONE_NUMBER
from utils import normalize, contains_term, extract_price, extract_product_name
from db import save_terms, load_terms, add_term, remove_term, get_term_history, get_db
from push_queue import enqueue_push_html

logger = logging.getLogger(__name__)

# ============================================================
# CONFIGURAÇÃO
# ============================================================
NOTIF_CHAT_ID = "me"
TERMOS_RELOAD_INTERVAL = 30
DEBOUNCE_PER_TERM = 60
MAX_TEXT_PREVIEW = 400
CACHE_TTL = 30 * 60
DEBUG = True

# Fase 2 — novos parâmetros
IGNORE_ALL_BOTS = True          # ignora mensagens de QUALQUER bot (exceto o seu)
ONLY_GROUPS = True              # só processa grupos/canais, ignora DMs
DELETE_COMMANDS = False         # apaga /comandos do grupo após N segundos
DELETE_COMMAND_DELAY = 5        # segundos
MAX_ULTIMOS_ENVIOS = 500        # limita tamanho do cache de debounce

# ============================================================
# ESTADO GLOBAL
# ============================================================
mensagens_processadas = {}
_me_id = None
_me_username = None
_ultimo_reload = 0.0
_ultimos_envios = {}
_start_time = time.time()

# ============================================================
# CARREGAMENTO DE TERMOS
# ============================================================
TERMOS = load_terms()
if not TERMOS:
    from config import TERMOS_ENV
    TERMOS = [t.strip() for t in TERMOS_ENV.split(",") if t.strip()]
    save_terms(TERMOS)

client = TelegramClient(StringSession(SESSION), API_ID, API_HASH)


# ============================================================
# PUSH EXTERNO
# ============================================================
async def send_notification_push(html_texto: str):
    try:
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(
            None,
            lambda: enqueue_push_html(html_texto, optimistic=True),
        )
    except Exception as e:
        logger.error(f"Erro ao enfileirar push: {e}")


# ============================================================
# UTILITÁRIOS
# ============================================================
def _uptime() -> str:
    s = int(time.time() - _start_time)
    h, r = divmod(s, 3600)
    m, sec = divmod(r, 60)
    return f"{h:02d}:{m:02d}:{sec:02d}"


def _is_command(text: str) -> bool:
    return bool(text) and text.lstrip().startswith("/")


def _deve_notificar(termo: str) -> bool:
    agora = time.time()
    ultimo = _ultimos_envios.get(termo)
    if ultimo is None:
        return True
    if agora - ultimo >= DEBOUNCE_PER_TERM:
        return True
    if DEBUG:
        logger.info(
            "[DEBOUNCE] '%s' ignorado. Restam %.1fs",
            termo, DEBOUNCE_PER_TERM - (agora - ultimo),
        )
    return False


def _podar_cache_debounce():
    """Limita o tamanho do cache de debounce para evitar crescimento infinito."""
    if len(_ultimos_envios) <= MAX_ULTIMOS_ENVIOS:
        return
    # Remove os mais antigos
    ordenado = sorted(_ultimos_envios.items(), key=lambda kv: kv[1])
    for termo, _ in ordenado[: len(_ultimos_envios) - MAX_ULTIMOS_ENVIOS]:
        _ultimos_envios.pop(termo, None)


async def _reload_termos_se_preciso():
    global TERMOS, _ultimo_reload
    agora = time.time()
    if agora - _ultimo_reload < TERMOS_RELOAD_INTERVAL:
        return
    try:
        novos = load_terms()
        if novos != TERMOS:
            logger.info("[TERMOS] Atualizados: %s", novos)
            TERMOS = novos
        _ultimo_reload = agora
    except Exception:
        logger.exception("[TERMOS] Erro ao recarregar")


async def _enviar_notificacao(mensagem: str) -> bool:
    try:
        await client.send_message(NOTIF_CHAT_ID, mensagem, parse_mode="html")
        return True
    except FloodWaitError as e:
        logger.warning("[TELEGRAM] FloodWait %ss", e.seconds)
        await asyncio.sleep(e.seconds)
        try:
            await client.send_message(NOTIF_CHAT_ID, mensagem, parse_mode="html")
            return True
        except Exception:
            logger.exception("[TELEGRAM] Falha pós-FloodWait")
            return False
    except Exception:
        logger.exception("[TELEGRAM] Erro ao enviar")
        return False


async def _responder(event, texto: str):
    try:
        await client.send_message(event.chat_id, texto, parse_mode="html")
        return
    except Exception:
        logger.exception("[CMD] Erro com HTML, tentando sem parse_mode")
    try:
        limpo = (texto
                 .replace("<b>", "").replace("</b>", "")
                 .replace("<code>", "").replace("</code>", "")
                 .replace("<i>", "").replace("</i>", ""))
        await client.send_message(event.chat_id, limpo)
    except Exception:
        logger.exception("[CMD] Falha total ao responder")


async def _auto_delete(event):
    """Apaga o comando do chat após N segundos (se DELETE_COMMANDS=True)."""
    if not DELETE_COMMANDS:
        return
    try:
        await asyncio.sleep(DELETE_COMMAND_DELAY)
        await event.delete()
    except Exception:
        pass


# ============================================================
# PROCESSAMENTO DE MENSAGENS DOS GRUPOS
# ============================================================
@client.on(events.NewMessage)
async def handler(event):
    try:
        await process_message(event)
    except FloodWaitError as e:
        await asyncio.sleep(e.seconds)
    except Exception as e:
        logger.error(f"Erro no handler: {e}", exc_info=True)


async def process_message(event):
    # 1) Ignora mensagens próprias
    if event.out:
        return
    if _me_id is not None and event.sender_id == _me_id:
        return

    raw_text = event.raw_text or ""

    # 2) Ignora comandos
    if _is_command(raw_text):
        return

    # 3) Filtro de tipo de chat (novo — Fase 2.2)
    if ONLY_GROUPS:
        chat = await event.get_chat()
        if isinstance(chat, User):
            # DM: ignora
            return

    # 4) Filtro de bots (novo — Fase 2.1)
    try:
        sender = await event.get_sender()
        sender_username = (getattr(sender, "username", "") or "").lower()

        # Sempre ignora o próprio bot (caso ele esteja nos grupos)
        if _me_username and sender_username == _me_username:
            return

        if IGNORE_ALL_BOTS and getattr(sender, "bot", False):
            if DEBUG:
                logger.info("[SKIP] mensagem de outro bot (@%s)", sender_username)
            return
    except Exception:
        pass

    # 5) Cache de deduplicação
    now = time.time()
    mensagens_processadas[event.id] = now
    for msg_id, ts in list(mensagens_processadas.items()):
        if now - ts > CACHE_TTL:
            mensagens_processadas.pop(msg_id, None)

    msg_original = raw_text.strip()
    if not msg_original:
        return

    await _reload_termos_se_preciso()

    chat = await event.get_chat()
    chat_title_raw = getattr(chat, "title", None) or "Chat Privado"
    chat_title = html.escape(str(chat_title_raw))
    msg_limpa = normalize(msg_original)

    if DEBUG:
        logger.info("[CHECK] TERMOS=%s | msg=%r", TERMOS, msg_limpa[:100])

    for termo in TERMOS:
        if not contains_term(msg_limpa, termo):
            continue

        if not _deve_notificar(termo):
            continue

        try:
            msg_link = event.message.get_url() or "Link indisponível"
        except Exception:
            msg_link = "Link indisponível"

        preco = extract_price(msg_original) or "Não identificado"
        produto = html.escape(str(extract_product_name(msg_original)))
        preview = html.escape(msg_original[:MAX_TEXT_PREVIEW])
        termo_esc = html.escape(str(termo))

        alerta_html = (
            "<b>🔥 Oferta encontrada!</b>\n\n"
            f"<b>🧩 Termo:</b> <code>{termo_esc}</code>\n"
            f"<b>💬 Grupo:</b> {chat_title}\n"
            f"<b>💰 Preço:</b> {preco}\n"
            f"<b>📦 Produto:</b> {produto}\n"
            f"<b>🔗 Link:</b> {msg_link}\n\n"
            "<b>📝</b>\n"
            f"{preview}"
        )

        logger.info("[MATCH] '%s' em '%s'", termo, chat_title)
        enviado = await _enviar_notificacao(alerta_html)

        if enviado:
            _ultimos_envios[termo] = time.time()
            _podar_cache_debounce()
            await send_notification_push(alerta_html)
        break


# ============================================================
# COMANDOS
# ============================================================

@client.on(events.NewMessage(pattern=r'^/start(?:@\w+)?\b'))
async def start_handler(event):
    logger.info("[CMD] /start em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    await _responder(
        event,
        "🤖 <b>Minhas Promos</b>\n\n"
        f"Monitorando {len(TERMOS)} termos.\n\n"
        "<b>Comandos:</b>\n"
        "/termos — lista\n"
        "/addtermo TERMO — adiciona\n"
        "/deltermo TERMO — remove\n"
        "/settermos T1, T2 — substitui\n"
        "/delall — remove todos\n"
        "/status — status\n"
        "/historico — últimas alterações\n"
        "/chatid — ID do chat atual\n"
        "/debug on|off — liga/desliga logs [CHECK]",
    )


@client.on(events.NewMessage(pattern=r'^/termos(?:@\w+)?\b'))
async def list_termos_handler(event):
    logger.info("[CMD] /termos em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    termos = load_terms()
    if not termos:
        await _responder(event, "📭 Nenhum termo cadastrado.")
        return
    linhas = "\n".join(f"• <code>{html.escape(str(t))}</code>" for t in termos)
    await _responder(event, f"<b>Termos ({len(termos)}):</b>\n{linhas}")


@client.on(events.NewMessage(pattern=r'^/settermos(?:@\w+)?\s+(.+)'))
async def set_termos_handler(event):
    logger.info("[CMD] /settermos em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    try:
        novos = [t.strip() for t in event.pattern_match.group(1).split(",") if t.strip()]
        if novos:
            global TERMOS
            TERMOS = novos
            save_terms(TERMOS)
            await _responder(event, "✅ Termos atualizados:\n" + ", ".join(TERMOS))
    except Exception as e:
        logger.error(e)
        await _responder(event, f"❌ Erro: {html.escape(str(e))}")


@client.on(events.NewMessage(pattern=r'^/addtermo(?:@\w+)?\s+(.+)'))
async def add_termo_handler(event):
    logger.info("[CMD] /addtermo em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    termo = event.pattern_match.group(1).strip()
    if not termo:
        await _responder(event, "Uso: /addtermo <termo>")
        return
    if termo.lower() in {t.lower() for t in TERMOS}:
        await _responder(event, f"⚠️ Termo '{html.escape(termo)}' já existe.")
        return
    if add_term(termo):
        TERMOS.append(termo)
        await _responder(event, f"✅ Termo '{html.escape(termo)}' adicionado.")
    else:
        await _responder(event, "❌ Erro ao adicionar.")


@client.on(events.NewMessage(pattern=r'^/deltermo(?:@\w+)?\s+(.+)'))
async def del_termo_handler(event):
    logger.info("[CMD] /deltermo em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    termo = event.pattern_match.group(1).strip()
    if not termo:
        await _responder(event, "Uso: /deltermo <termo>")
        return
    if remove_term(termo):
        global TERMOS
        TERMOS = load_terms()
        await _responder(event, f"🗑️ Termo '{html.escape(termo)}' removido.")
    else:
        await _responder(event, f"❌ Termo '{html.escape(termo)}' não encontrado.")


@client.on(events.NewMessage(pattern=r'^/delall(?:@\w+)?\b'))
async def delall_handler(event):
    logger.info("[CMD] /delall em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    global TERMOS
    save_terms([])
    TERMOS = []
    await _responder(event, "🗑️ Todos os termos removidos.")


@client.on(events.NewMessage(pattern=r'^/status(?:@\w+)?\b'))
async def status_handler(event):
    logger.info("[CMD] /status em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    try:
        db = get_db()
        h = db.health()
        await _responder(
            event,
            "🩺 <b>Status</b>\n"
            f"• Uptime: <code>{_uptime()}</code>\n"
            f"• Termos: <b>{len(TERMOS)}</b>\n"
            f"• DB: <b>{h['connected']}</b>\n"
            f"• Integrity: <code>{h['integrity_check']}</code>\n"
            f"• WAL: <b>{h['wal_mode']}</b>\n"
            f"• Fila push: <b>{db.push_queue_count()}</b>\n"
            f"• Debug: <b>{DEBUG}</b>",
        )
    except Exception as e:
        await _responder(event, f"❌ Erro: {html.escape(str(e))}")


@client.on(events.NewMessage(pattern=r'^/historico(?:@\w+)?\b'))
async def historico_handler(event):
    logger.info("[CMD] /historico em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    try:
        hist = get_term_history(limit=20)
        if not hist:
            await _responder(event, "📭 Sem histórico.")
            return
        linhas = []
        for item in hist:
            term = html.escape(str(item.get("term", "")))
            action = item.get("action", "")
            ts = item.get("timestamp", "")
            label = "A" if action == "added" else ("D" if action == "removed" else "?")
            linhas.append(f"[{label}] <code>{term}</code> — {ts}")
        await _responder(event, "<b>Últimas 20:</b>\n" + "\n".join(linhas))
    except Exception as e:
        await _responder(event, f"❌ Erro: {html.escape(str(e))}")


@client.on(events.NewMessage(pattern=r'^/chatid(?:@\w+)?\b'))
async def chatid_handler(event):
    logger.info("[CMD] /chatid em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    chat = await event.get_chat()
    tipo = "Desconhecido"
    if isinstance(chat, User):
        tipo = "Usuário (DM)"
    elif isinstance(chat, Chat):
        tipo = "Grupo"
    elif isinstance(chat, Channel):
        tipo = "Canal" if getattr(chat, "broadcast", False) else "Supergrupo"

    await _responder(
        event,
        "📍 <b>Informações do chat</b>\n"
        f"• Tipo: <b>{tipo}</b>\n"
        f"• chat_id: <code>{event.chat_id}</code>\n"
        f"• Título: {html.escape(str(getattr(chat, 'title', 'N/A')))}\n"
        f"• Username: @{getattr(chat, 'username', 'N/A') or 'N/A'}",
    )


@client.on(events.NewMessage(pattern=r'^/debug(?:\s+(on|off))?(?:@\w+)?\b'))
async def debug_handler(event):
    logger.info("[CMD] /debug em chat=%s", event.chat_id)
    asyncio.create_task(_auto_delete(event))
    global DEBUG
    arg = event.pattern_match.group(1)
    if arg is None:
        await _responder(event, f"🔧 Debug está <b>{'ON' if DEBUG else 'OFF'}</b>.")
        return
    if arg.lower() == "on":
        DEBUG = True
        await _responder(event, "✅ Debug <b>ON</b>. Logs [CHECK] aparecerão.")
    elif arg.lower() == "off":
        DEBUG = False
        await _responder(event, "🔇 Debug <b>OFF</b>.")
    else:
        await _responder(event, "Uso: /debug on|off")


# ============================================================
# MAIN
# ============================================================
async def main():
    global _me_id, _me_username
    try:
        await client.connect()
        me = await client.get_me()
        _me_id = me.id
        _me_username = (getattr(me, "username", "") or "").lower() or None

        logger.info("=" * 60)
        logger.info("Logado: id=%s username=%s bot=%s", me.id, me.username, me.bot)
        logger.info("TERMOS carregados: %s", TERMOS)
        logger.info("NOTIF_CHAT_ID: %s", NOTIF_CHAT_ID)
        logger.info("DEBUG: %s | ONLY_GROUPS: %s | IGNORE_ALL_BOTS: %s | DELETE_COMMANDS: %s",
                    DEBUG, ONLY_GROUPS, IGNORE_ALL_BOTS, DELETE_COMMANDS)
        logger.info("=" * 60)

        if me.bot:
            logger.warning("⚠️ Sessão é de BOT. Regenere a SESSION com login por telefone.")

        await send_notification_push("<b>Bot iniciado</b>")
        await client.run_until_disconnected()

    except Exception as e:
        logger.error(f"Erro no main: {e}", exc_info=True)


if __name__ == "__main__":
    asyncio.run(main())